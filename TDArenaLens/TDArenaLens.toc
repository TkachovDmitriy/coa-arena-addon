## Interface: 30300
## Title: TD ArenaLens
## Notes: Arena companion — logs matches, opponents and cooldowns.
## Author: TkachovDmitriy
## Version: 0.1.0-dev
## SavedVariables: TDArenaLensDB
## SavedVariablesPerCharacter: TDArenaLensCharDB

# Load order matters: locales, core, shared helpers, then feature domains.
# Within a domain, load data/store before the modules that use it.
locales\en_us.lua

core.lua

shared\util.lua

# feature: arena_log
features\arena_log\store.lua
features\arena_log\opponent_capture.lua
features\arena_log\arena_session.lua
features\arena_log\history_frame.lua

# feature: diagnostics
features\diagnostics\reporting.lua
features\diagnostics\action_bar.lua
features\diagnostics\log_frame.lua

# feature: commands
features\commands\slash_commands.lua

# feature: launcher
features\launcher\minimap_button.lua

# feature: cooldowns
features\cooldowns\tracker.lua
features\cooldowns\icons.lua
